    {
      "name": "list_changes",
      "description": "GET /v1/changes. Cursor-paginated change feed. Each item includes summary, severity, why_it_matters, monitor_type, and review_status. Response includes meta.counts and max_unreviewed_severity.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": [
              "string",
              "number"
            ],
            "description": "Workspace id from list_workspaces or create_workspace"
          },
          "competitor_id": {
            "type": [
              "string",
              "number"
            ]
          },
          "min_severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "review_status": {
            "type": "string",
            "enum": [
              "unreviewed",
              "acknowledged",
              "dismissed"
            ]
          },
          "since": {
            "type": "string",
            "description": "ISO8601 or 1d, 7d, 30d"
          },
          "monitor_type": {
            "type": "string",
            "enum": [
              "homepage",
              "blog",
              "docs",
              "changelog",
              "pricing"
            ]
          },
          "limit": {
            "type": "number",
            "description": "1-100, default 25"
          },
          "after": {
            "$ref": "#/properties/competitor_id",
            "description": "Cursor from next_cursor"
          }
        },
        "required": [
          "workspace_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
