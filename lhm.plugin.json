    {
      "name": "add_competitor",
      "description": "POST /v1/workspaces/:id/competitors. Add a competitor by homepage URL. Idempotent on duplicate URLs. Returns 409 with active_competitor_id when another discovery is running.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": [
              "string",
              "number"
            ],
            "description": "Workspace id from list_workspaces or create_workspace"
          },
          "url": {
            "type": "string",
            "description": "Competitor homepage URL"
          },
          "monitor_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "blog",
                "changelog",
                "pricing",
                "docs",
                "homepage"
              ]
            },
            "description": "Limit discovery to these surface types"
          }
        },
        "required": [
          "workspace_id",
          "url"
